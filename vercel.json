{
  "routes": [
    {
      "src": "^/demos/ano-nuevo(?:/index\\.html|/)?$",
      "status": 308,
      "headers": { "Location": "/demos/celebra-2027/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "spooky.nordrastudio.mx" }],
      "dest": "/invitaciones/spooky-party/index.html"
    },
    {
      "src": "^/favicon\\.svg$",
      "has": [{ "type": "host", "value": "spooky.nordrastudio.mx" }],
      "dest": "/invitaciones/spooky-party/favicon.svg"
    },
    {
      "src": "^/invitacion-original\\.jpeg$",
      "has": [{ "type": "host", "value": "spooky.nordrastudio.mx" }],
      "dest": "/invitaciones/spooky-party/invitacion-original.jpeg"
    },
    { "handle": "filesystem" }
  ]
}
