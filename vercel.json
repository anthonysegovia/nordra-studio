{
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(self), microphone=(), geolocation=(), payment=(), usb=()",
        "X-Frame-Options": "SAMEORIGIN",
        "Content-Security-Policy-Report-Only": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://va.vercel-scripts.com https://vercel.live; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' https://vitals.vercel-insights.com https://va.vercel-scripts.com; frame-src 'self' https://www.google.com https://maps.google.com https://vercel.live; worker-src 'self' blob:; form-action 'self' https://wa.me https://www.mercadopago.com.mx https://www.mercadopago.com"
      },
      "continue": true
    },
    {
      "src": "^/favicon\\.ico$",
      "has": [
        {
          "type": "host",
          "value": "confirmadoscova.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/posada-confirmados/assets/confirmados-icon-v1.ico"
    },
    {
      "src": "^/apple-touch-icon\\.png$",
      "has": [
        {
          "type": "host",
          "value": "confirmadoscova.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/posada-confirmados/assets/confirmados-apple-v1.png"
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "confirmadoscova.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/posada-confirmados/index.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "^/demos/cafe-nordra(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "/demos/sobremesa/"
      }
    },
    {
      "src": "^/invitaciones/sofia-25(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "/invitaciones/camila-30/"
      }
    },
    {
      "src": "^/invitaciones/sofia-25/fecha\\.ics$",
      "status": 308,
      "headers": {
        "Location": "/invitaciones/camila-30/fecha.ics"
      }
    },
    {
      "src": "^/demos/lumina(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "/demos/nitida/"
      }
    },
    {
      "src": "^/demos/ano-nuevo(?:/index\\.html|/)?$",
      "status": 308,
      "headers": {
        "Location": "/demos/celebra-2027/"
      }
    },
    {
      "src": "^/$",
      "has": [
        {
          "type": "host",
          "value": "spooky.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/spooky-party/index.html"
    },
    {
      "src": "^/favicon\\.svg$",
      "has": [
        {
          "type": "host",
          "value": "spooky.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/spooky-party/favicon.svg"
    },
    {
      "src": "^/invitacion-original\\.jpeg$",
      "has": [
        {
          "type": "host",
          "value": "spooky.nordrastudio.mx"
        }
      ],
      "dest": "/invitaciones/spooky-party/invitacion-original.jpeg"
    },
    {
      "src": "^/(?:index\\.html|(?:estudio|negocios|invitaciones|bodas|cumpleanos|eventos|temporada)(?:\\.html)?)?$",
      "has": [
        {
          "type": "query",
          "key": "panel"
        }
      ],
      "dest": "/gestion.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "^/(?:index\\.html|(?:estudio|negocios|invitaciones|bodas|cumpleanos|eventos|temporada)(?:\\.html)?)?$",
      "has": [
        {
          "type": "query",
          "key": "pago"
        }
      ],
      "dest": "/gestion.html",
      "headers": {
        "X-Robots-Tag": "noindex, nofollow"
      }
    },
    {
      "src": "^/portada\\.html$",
      "status": 308,
      "headers": {
        "Location": "/"
      }
    },
    {
      "src": "^/(estudio|negocios|invitaciones|bodas|cumpleanos|eventos|temporada)\\.html$",
      "status": 308,
      "headers": {
        "Location": "/$1"
      }
    },
    {
      "src": "^/(estudio|negocios|invitaciones|bodas|cumpleanos|eventos|temporada)$",
      "dest": "/$1.html"
    },
    {
      "src": "^/invitaciones/(camila-30|conexion-27)(?:/index\\.html)?$",
      "status": 308,
      "headers": {
        "Location": "/invitaciones/$1/"
      }
    },
    {
      "src": "^/invitaciones/(camila-30|conexion-27)/$",
      "dest": "/invitaciones/$1/index.html"
    },
    {
      "src": "^/en/(estudio|negocios|invitaciones|bodas|cumpleanos|eventos|temporada|aviso-de-privacidad)$",
      "dest": "/en/$1.html"
    },
    {
      "src": "^/aviso-de-privacidad(?:\\.html)?$",
      "dest": "/aviso-de-privacidad/index.html"
    },
    {
      "src": "^/en/$",
      "dest": "/en/index.html"
    },
    {
      "src": "^/terminos-del-servicio$",
      "dest": "/terminos-del-servicio.html"
    },
    {
      "src": "^/en/terminos-del-servicio$",
      "dest": "/en/terminos-del-servicio.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "handle": "error"
    },
    {
      "src": "^(?!/api/).*$",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
